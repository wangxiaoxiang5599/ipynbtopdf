{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "out",
        "-l",
        "3010",
        "-s"
      ],
      "port": 3010
    }
  ]
}